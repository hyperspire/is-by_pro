[Unit]
Description=is-by_pro social network service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/is-by_pro
Environment="RUST_LOG=info"
LimitNOFILE=65535
ExecStart=/home/opc/is-by_pro/target/release/is-by_pro
Restart=on-failure
RestartSec=5
MemoryMax=8GiB
CPUAccounting=true
StandardOutput=append:/home/opc/logs/is-by_pro.log
StandardError=append:/home/opc/logs/is-by_pro.log

[Install]
WantedBy=multi-user.target
